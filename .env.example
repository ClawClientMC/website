# Public configuration only. Do not place secrets in NEXT_PUBLIC_* variables.
# Leave these unset for the default local/production-safe baseline.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_RELEASES_API_URL=
NEXT_PUBLIC_ANALYTICS_MEASUREMENT_ID=

# Server-only configuration (never exposed to browser)
# Platform API base URL for authentication (e.g., https://api.clawclient.net)
PLATFORM_API_URL=
